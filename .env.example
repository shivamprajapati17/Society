# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- AI triage (server only) ---
ANTHROPIC_API_KEY=

# --- Optional: digest email ---
RESEND_API_KEY=
DIGEST_FROM=digest@yourdomain.com

# --- Cron auth (random 32+ chars) ---
CRON_SECRET=change-me-to-a-long-random-string

# --- App URL ---
# local: http://localhost:3000  |  prod: https://societymatter.vercel.app
APP_URL=http://localhost:3000
