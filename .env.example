# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- AI triage via NVIDIA NIM (server only) ---
# Get a key at https://build.nvidia.com  (starts with nvapi-)
NVIDIA_API_KEY=
# Optional overrides. The default model is verified against the sample
# complaints in 07-IMPLEMENTATION-PLAN.md.
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Optional: digest email ---
RESEND_API_KEY=
DIGEST_FROM=digest@yourdomain.com

# --- Cron auth (random 32+ chars) ---
CRON_SECRET=change-me-to-a-long-random-string

# --- App URL ---
# local: http://localhost:3000  |  prod: https://societymatter.vercel.app
APP_URL=http://localhost:3000
